# 이 파일을 .env 로 복사한 뒤 값을 채우세요.  (.env 는 커밋되지 않습니다)

# 블로그 주소가 https://blog.naver.com/hong1234 이면 BLOG_ID=hong1234
BLOG_ID=

# 발행 사이 최소 간격(초). 연속 발행 시 차단 위험을 줄입니다. 기본 60
MIN_PUBLISH_INTERVAL_SEC=60

# ─────────────────────────────────────────────────────────────
# 네이버 아이디/비밀번호는 여기에 넣지 않습니다.
# `npm run login` 으로 브라우저에서 직접 한 번 로그인하면
# 세션만 .auth/ 에 저장되어 이후 재사용됩니다.
# ─────────────────────────────────────────────────────────────
