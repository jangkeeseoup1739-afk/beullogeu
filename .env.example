# ─────────────────────────────────────────────────────────────
# realestate-threads-auto 환경 변수 예시
#
# 이 파일은 "예시"입니다. 실제 값은 여기에 적지 마세요.
# 로컬 테스트: 이 파일을 복사해 .env.local 로 만들고 값을 채우세요. (.env.local 은 커밋되지 않습니다)
# 실제 운영: Vercel 프로젝트 Settings → Environment Variables,
#            GitHub 저장소 Settings → Secrets and variables → Actions 에 등록하세요.
# ─────────────────────────────────────────────────────────────

# [필수] Anthropic API 키 — 뉴스 조사와 콘텐츠 생성에 사용
# 발급: https://console.anthropic.com → API keys
ANTHROPIC_API_KEY=sk-ant-여기에-키를-붙여넣으세요

# [필수] Threads 장기 액세스 토큰 (60일, 24시간 후부터 갱신 가능)
# 발급: Meta 개발자 앱 → Threads API → 사용자 토큰 생성
THREADS_ACCESS_TOKEN=여기에-토큰을-붙여넣으세요

# [필수] Threads 사용자 ID (숫자)
# 확인: GET https://graph.threads.net/v1.0/me?fields=id,username&access_token=토큰
THREADS_USER_ID=여기에-숫자-ID를-붙여넣으세요

# [필수] 관리자 화면 로그인 비밀번호 (직접 정하세요. 16자 이상 권장)
ADMIN_PASSWORD=직접-정한-긴-비밀번호

# [필수] GitHub Actions → Vercel API 호출 시 쓰는 공용 비밀값 (직접 정하세요)
# 터미널에서 만들기: openssl rand -hex 32
CRON_SECRET=랜덤한-긴-문자열

# [자동] Vercel Blob 스토어를 만들면 Vercel이 자동으로 넣어줍니다.
# 로컬에서는 비워두면 data/ 폴더에 파일로 저장합니다.
BLOB_READ_WRITE_TOKEN=

# [선택] Vercel 배포 주소. GitHub Actions에서 Vercel API를 부를 때 사용합니다.
APP_BASE_URL=https://realestate-threads-auto.vercel.app

# [선택] 토큰 발급일(YYYY-MM-DD). 넣어두면 만료 D-14 부터 관리자 화면에 경고가 뜹니다.
THREADS_TOKEN_ISSUED_AT=

# [선택] 자동 게시 전체 스위치. false 로 두면 모든 글이 승인 대기 상태로만 쌓입니다.
AUTO_PUBLISH=true
